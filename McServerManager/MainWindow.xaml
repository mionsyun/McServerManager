<Window x:Class="McServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:McServerManager.ViewModels"
        xmlns:views="clr-namespace:McServerManager.Views"
        x:Name="MainWindowRoot"
        Title="MaiPilot"
        Icon="icon-square.png"
        Width="1280"
        Height="840"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ServerViewModel}">
            <views:ServerDetailControl />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource BrushBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="20,24,20,20">
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Image Source="icon.png"
                           Width="56"
                           Height="56"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="MaiPilot"
                               FontFamily="./Fonts/#Press Start 2P"
                               FontSize="15"
                               Foreground="{DynamicResource BrushAccent}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,20,0,0" Opacity="0.4"/>

                <TextBlock Text="テーマ" Style="{StaticResource MutedText}" Margin="0,20,0,8" FontSize="11" FontWeight="Medium"/>
                <ToggleButton Content="{Binding ThemeLabel}" IsChecked="{Binding IsDarkTheme}" Width="100" HorizontalAlignment="Left"/>

                <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,20,0,0" Opacity="0.4"/>

                <TextBlock Text="情報" Style="{StaticResource MutedText}" Margin="0,20,0,8" FontSize="11" FontWeight="Medium"/>
                <Button Content="サードパーティ通知" Click="OpenThirdPartyNotices" FontSize="11.5" HorizontalAlignment="Stretch"/>
                <Button Content="アプリ更新を確認" Command="{Binding CheckAppUpdateCommand}" Margin="0,8,0,0" FontSize="11.5" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="28"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="サーバーリスト" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="NewServerButton" Content="＋ サーバーを追加" Command="{Binding CreateServerCommand}"
                            Style="{StaticResource PrimaryButton}" Height="42" Padding="20,8" FontSize="14"/>
                    <Button Content="セットアップガイド" Command="{Binding StartTutorialCommand}" Margin="12,0,0,0" Height="42" Padding="16,8" FontSize="13"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,20,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="サーバー一覧" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>
                        <ListBox x:Name="ServerListBox"
                                 ItemsSource="{Binding Servers}"
                                 SelectedItem="{Binding SelectedServer}"
                                 ItemContainerStyle="{StaticResource ServerListItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="ポート:" Style="{StaticResource MutedText}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Port}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="バージョン:" Style="{StaticResource MutedText}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Version}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastStartedAtText, StringFormat=最終起動: {0}}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Foreground="{DynamicResource BrushText}"
                                                Style="{StaticResource CardMenuButton}"
                                                Margin="8,2,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Click="OpenServerItemMenu">
                                            <TextBlock Text="︙"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            <Button.ContextMenu>
                                                <ContextMenu Foreground="{DynamicResource BrushText}">
                                                    <MenuItem Header="削除"
                                                              Command="{Binding DataContext.DeleteServerCommand, Source={x:Reference MainWindowRoot}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="複製"
                                                              Command="{Binding DataContext.DuplicateServerCommand, Source={x:Reference MainWindowRoot}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="更新"
                                                              Command="{Binding DataContext.RefreshCommand, Source={x:Reference MainWindowRoot}}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid Margin="8">
                        <ContentControl Content="{Binding SelectedServer}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedServer}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedServer}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="サーバーが未選択です" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="左の一覧からサーバーを選ぶか、新規作成してください。" Style="{StaticResource MutedText}" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12.5"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <views:TutorialOverlayControl x:Name="TutorialOverlay"
                                      Grid.ColumnSpan="2"
                                      DataContext="{Binding Tutorial}"
                                      Panel.ZIndex="1000"/>
    </Grid>
</Window>
