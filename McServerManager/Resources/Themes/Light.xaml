<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBg">#D7E2EF</Color>
    <Color x:Key="ColorSurface">#E7EEF7</Color>
    <Color x:Key="ColorCard">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#A9B8CD</Color>
    <Color x:Key="ColorAccent">#2B6CB0</Color>
    <Color x:Key="ColorAccentSoft">#E1EDFF</Color>
    <Color x:Key="ColorText">#1A2433</Color>
    <Color x:Key="ColorTextMuted">#536275</Color>

    <LinearGradientBrush x:Key="BrushBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D7E2EF" Offset="0"/>
        <GradientStop Color="#CBD9EA" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}"/>
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushHover" Color="#DCE6F2"/>
    <SolidColorBrush x:Key="BrushPressed" Color="#D0DBEB"/>
    <SolidColorBrush x:Key="BrushBorderHover" Color="#7E92B0"/>
    <SolidColorBrush x:Key="BrushOverlayDim" Color="#A0000000"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="#1E5A9E"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#2E7D32"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#E65100"/>
    <SolidColorBrush x:Key="BrushError" Color="#C62828"/>
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="#E8F5E9"/>
    <SolidColorBrush x:Key="BrushWarningSoft" Color="#FFF3E0"/>
    <SolidColorBrush x:Key="BrushErrorSoft" Color="#FFEBEE"/>
    <SolidColorBrush x:Key="BrushTerminalBg" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="BrushTerminalFg" Color="#1A2433"/>
</ResourceDictionary>
