{
  "name": "mc-server-manager-landing",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "npm run prepare:seo && npm run prepare:docs-aliases && nuxt build",
    "prepare:seo": "node ./scripts/prepare-doc-seo.mjs",
    "prepare:docs-aliases": "node ./scripts/create-doc-aliases.mjs",
    "sync:docs-output": "node ./scripts/sync-docs-to-output.mjs",
    "generate": "npm run prepare:seo && npm run prepare:docs-aliases && nuxt generate && npm run sync:docs-output",
    "preview": "nuxt preview"
  },
  "dependencies": {
    "nuxt": "3.14.0"
  },
  "overrides": {
    "nitropack": "2.10.4"
  }
}
