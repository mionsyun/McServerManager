<Window x:Class="McServerManager.Views.NewServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新規サーバー作成"
        Width="760"
        Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="基本設定">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="22">
                        <TextBlock Text="サーバー名"/>
                        <TextBox Text="{Binding Name}"/>

                        <TextBlock Text="保存先フォルダ" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding DirectoryPath}" Width="520"/>
                            <Button Content="参照" Command="{Binding BrowseDirectoryCommand}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="サーバー種別" Margin="0,12,0,0"/>
                        <ComboBox ItemsSource="{Binding ServerTypes}" SelectedItem="{Binding SelectedServerType}" DisplayMemberPath="Label" Width="320"/>

                        <TextBlock Text="Minecraft バージョン" Margin="0,12,0,0"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding VersionFilters}"
                                      SelectedItem="{Binding SelectedVersionFilter}"
                                      DisplayMemberPath="Label"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Versions}"
                                      SelectedItem="{Binding SelectedVersion}"
                                      DisplayMemberPath="Id"
                                      Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Content="更新" Command="{Binding RefreshVersionsCommand}" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding VersionFilterSummary}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedVersionInfo}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ModVersionHint}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="MOTD" Margin="0,12,0,0"/>
                        <TextBox Text="{Binding Motd}" Margin="0,0,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="リソース">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="22">
                        <TextBlock Text="メモリ割り当て (Xms / Xmx MB)"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding MemoryXms}" Width="120"/>
                            <TextBlock Text=" / " VerticalAlignment="Center" Margin="6,0"/>
                            <TextBox Text="{Binding MemoryXmx}" Width="120"/>
                        </StackPanel>

                        <TextBlock Text="Java パス" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding JavaPath}" Width="520"/>
                            <Button Content="参照" Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ネットワーク">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="22">
                        <TextBlock Text="ポート"/>
                        <TextBox Text="{Binding Port}" Width="120"/>
                        <TextBlock Text="最大人数" Margin="0,12,0,0"/>
                        <TextBox Text="{Binding MaxPlayers}" Width="120"/>
                        <CheckBox Content="オンラインモード" IsChecked="{Binding OnlineMode}" Margin="0,12,0,0"/>
                        <CheckBox Content="コマンドブロックを有効化 (enable-command-block)"
                                  IsChecked="{Binding EnableCommandBlock}"
                                  Margin="0,8,0,0"/>
                        <TextBlock Text="配布マップ・コマンド実行系ギミックを使う場合は有効化を推奨します。"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="EULA">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="22">
                        <TextBlock TextWrapping="Wrap">
                            Minecraft サーバーの EULA に同意する必要があります。
                        </TextBlock>
                        <CheckBox Content="EULA に同意する" IsChecked="{Binding EulaAccepted}" Margin="0,12,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Background="{DynamicResource BrushCard}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,10,10,8">
            <StackPanel>
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProgressMessage}"
                                   Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProgressStep}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushAccent}"
                                   Margin="8,0,0,0"/>
                    </Grid>
                    <ProgressBar Height="6"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushError}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="キャンセル" Command="{Binding CancelCommand}" Width="110"/>
                    <Button Content="✨ 作成" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" Width="120" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
