<Window x:Class="McServerManager.Views.NewServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新しいサーバー"
        Width="820"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="新しいサーバー" Style="{StaticResource Eyebrow}"/>
                <TextBlock Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ScreenTitle}">
                            <Setter Property="Text" Value="作成方法を選んでください"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Route}" Value="easy"><Setter Property="Text" Value="おまかせ作成"/></DataTrigger>
                                <DataTrigger Binding="{Binding Route}" Value="advanced"><Setter Property="Text" Value="詳細設定で作成"/></DataTrigger>
                                <DataTrigger Binding="{Binding Route}" Value="import"><Setter Property="Text" Value="ファイルから取り込み"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="← 入口を選び直す" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                    Command="{Binding ResetRouteCommand}"
                    Visibility="{Binding IsRouteSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- 本体 -->
        <Grid Grid.Row="1">

            <!-- 入口選択 -->
            <UniformGrid Columns="3" Visibility="{Binding IsRouteSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Button Style="{StaticResource BaseButton}" Margin="0,0,8,0" Padding="18" Command="{Binding SelectRouteCommand}" CommandParameter="easy">
                    <StackPanel>
                        <TextBlock Text="★" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource BrushAccent}"/>
                        <TextBlock Text="おまかせ" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="「友達と遊ぶ」など遊び方から選ぶだけ。" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="プリセット → 名前 → 作成" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BaseButton}" Margin="0,0,8,0" Padding="18" Command="{Binding SelectRouteCommand}" CommandParameter="advanced">
                    <StackPanel>
                        <TextBlock Text="⚙" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource BrushAccent}"/>
                        <TextBlock Text="詳細設定" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="種別・バージョン・ポートを自分で指定。" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="種別 → バージョン → 接続 → 作成" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BaseButton}" Padding="18" Command="{Binding SelectRouteCommand}" CommandParameter="import">
                    <StackPanel>
                        <TextBlock Text="⇩" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource BrushAccent}"/>
                        <TextBlock Text="取り込み" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text=".mrpack / サーバーpack zip から取り込み。" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="ファイル → 名前 → 作成" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- おまかせ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Route, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=easy}">
                <StackPanel>
                    <TextBlock Text="用途を選択" Style="{StaticResource SectionHeading}"/>
                    <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Margin="0,8,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ServerListItem}">
                                <Setter Property="Margin" Value="4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Glyph}" FontSize="22"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontFamily="Cascadia Mono" FontSize="10.5" Margin="0,6,0,0">
                                        <Run Text="{Binding TypeId, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Ram, Mode=OneWay}"/><Run Text="MB · "/><Run Text="{Binding MaxPlayers, Mode=OneWay}"/><Run Text="人"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="サーバー名 *"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            <TextBlock Text="バージョン" Margin="0,12,0,0"/>
                            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Id" Width="240" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SelectedVersionInfo}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            <CheckBox Content="Minecraft EULA に同意する" IsChecked="{Binding EulaAccepted}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 詳細設定 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Route, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=advanced}">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="基本"/>
                            <TextBlock Text="サーバー名 *" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="保存先フォルダ" Margin="0,12,0,0"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DirectoryPath}"/>
                                <Button Grid.Column="1" Content="参照" Command="{Binding BrowseDirectoryCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="サーバー種別" Margin="0,12,0,0"/>
                            <ComboBox ItemsSource="{Binding ServerTypes}" SelectedItem="{Binding SelectedServerType}" DisplayMemberPath="Label" Width="320" HorizontalAlignment="Left"/>
                            <TextBlock Text="Minecraft バージョン" Margin="0,12,0,0"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding VersionFilters}" SelectedItem="{Binding SelectedVersionFilter}" DisplayMemberPath="Label"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Id" Margin="8,0,0,0"/>
                                <Button Grid.Column="2" Content="更新" Command="{Binding RefreshVersionsCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding VersionFilterSummary}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding ModVersionHint}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="MOTD" Margin="0,12,0,0"/>
                            <TextBox Text="{Binding Motd}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="リソース"/>
                            <TextBlock Text="メモリ割り当て (Xms / Xmx MB)" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding MemoryXms}" Width="120"/>
                                <TextBlock Text=" / " VerticalAlignment="Center" Margin="6,0"/>
                                <TextBox Text="{Binding MemoryXmx}" Width="120"/>
                            </StackPanel>
                            <TextBlock Text="Java パス" Margin="0,12,0,0"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding JavaPath}"/>
                                <Button Grid.Column="1" Content="参照" Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="接続"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="ポート"/>
                                    <TextBox Text="{Binding Port}" Width="120" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="最大人数"/>
                                    <TextBox Text="{Binding MaxPlayers}" Width="120" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Content="オンラインモード" IsChecked="{Binding OnlineMode}" Margin="0,12,0,0"/>
                            <CheckBox Content="コマンドブロックを有効化 (enable-command-block)" IsChecked="{Binding EnableCommandBlock}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="EULA"/>
                            <CheckBox Content="Minecraft EULA に同意する" IsChecked="{Binding EulaAccepted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 取り込み(近日対応) -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding Route, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=import}">
                <StackPanel HorizontalAlignment="Center" Margin="0,30">
                    <TextBlock Text="⇩" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock Text="ファイルからの取り込みは近日対応予定です" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource MutedText}" MaxWidth="420" Margin="0,8,0,0"
                               Text=".mrpack(Modrinth)やサーバーpack zip の取り込みに対応予定です。現在は「詳細設定」から手動で作成してください。"/>
                    <Button Content="詳細設定で作成 →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Command="{Binding SelectRouteCommand}" CommandParameter="advanced"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- フッター -->
        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource SurfacePanel}"
                Visibility="{Binding IsRouteSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProgressMessage}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressStep}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" Margin="8,0,0,0"/>
                    </Grid>
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushError}" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="キャンセル" Command="{Binding CancelCommand}" Width="110"/>
                    <Button Content="✨ サーバーを作成" Command="{Binding CreateCommand}" Width="160" Margin="10,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Route}" Value="import">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
