<Window x:Class="McServerManager.Views.NewServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新しいサーバー"
        Width="880"
        Height="720"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="新しいサーバー" Style="{StaticResource Eyebrow}"/>
                <TextBlock Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ScreenTitle}">
                            <Setter Property="Text" Value="どちらのマインクラフトで遊びますか？"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Route}" Value="easy"><Setter Property="Text" Value="おまかせ作成"/></DataTrigger>
                                <DataTrigger Binding="{Binding Route}" Value="advanced"><Setter Property="Text" Value="詳細設定で作成"/></DataTrigger>
                                <DataTrigger Binding="{Binding Route}" Value="import"><Setter Property="Text" Value="ファイルから取り込み"/></DataTrigger>
                                <DataTrigger Binding="{Binding Route}" Value="bedrock"><Setter Property="Text" Value="統合版サーバーを作成"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Text" Value="友達が遊んでいるエディションに合わせて選んでください。あとから変更はできません。"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Route}" Value="easy"><Setter Property="Text" Value="遊び方を選んで名前を付けるだけで作成できます。"/></DataTrigger>
                                <DataTrigger Binding="{Binding Route}" Value="advanced"><Setter Property="Text" Value="種別・バージョン・メモリ・ポートを自分で指定します。"/></DataTrigger>
                                <DataTrigger Binding="{Binding Route}" Value="bedrock"><Setter Property="Text" Value="Mojang 公式の Bedrock Dedicated Server を自動でダウンロードしてセットアップします。"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="← 入口を選び直す" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                    Command="{Binding ResetRouteCommand}"
                    Visibility="{Binding IsRouteSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- 本体 -->
        <Grid Grid.Row="1">

            <!-- ════ 入口: エディション → 作成方法 ════ -->
            <StackPanel Visibility="{Binding IsRouteSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <UniformGrid Columns="2">
                    <!-- Java 版 -->
                    <RadioButton Style="{StaticResource SelectableCard}" Margin="0,0,8,0" GroupName="Edition"
                                  IsChecked="{Binding Edition, Converter={StaticResource EqualsToBooleanConverter}, ConverterParameter=java, Mode=TwoWay}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" CornerRadius="14" VerticalAlignment="Top"
                                    Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1">
                                <TextBlock Text="Java" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="Java版" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="パソコン (Windows / Mac / Linux) で遊ぶ人向け。MOD やプラグインで自由にカスタマイズできます。"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,4"><TextBlock Text="PC のみ" FontSize="11"/></Border>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,4"><TextBlock Text="MOD / プラグイン" FontSize="11"/></Border>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,4"><TextBlock Text="Java が必要" FontSize="11"/></Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <!-- 統合版 -->
                    <RadioButton Style="{StaticResource SelectableCard}" Margin="8,0,0,0" GroupName="Edition"
                                  IsChecked="{Binding Edition, Converter={StaticResource EqualsToBooleanConverter}, ConverterParameter=bedrock, Mode=TwoWay}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" CornerRadius="14" VerticalAlignment="Top"
                                    Background="{DynamicResource BrushSuccessSoft}" BorderBrush="{DynamicResource BrushSuccess}" BorderThickness="1">
                                <TextBlock Text="BE" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushSuccess}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="統合版 (Bedrock)" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="スマホ・Switch・PlayStation・Xbox・Windows 版の友達と一緒に遊べます。"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,4"><TextBlock Text="クロスプレイ" FontSize="11"/></Border>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,4"><TextBlock Text="Java 不要" FontSize="11"/></Border>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,4"><TextBlock Text="公式サーバーソフト" FontSize="11"/></Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </RadioButton>
                </UniformGrid>

                <!-- Java 版: 作成方法 -->
                <StackPanel Visibility="{Binding IsBedrockEdition, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="作成方法" Style="{StaticResource SectionHeading}" Margin="0,22,0,10"/>
                    <UniformGrid Columns="3">
                        <Button Style="{StaticResource ChoiceButton}" Margin="0,0,8,0" Padding="18,20" Command="{Binding SelectRouteCommand}" CommandParameter="easy">
                            <StackPanel>
                                <TextBlock Text="★" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource BrushAccent}"/>
                                <TextBlock Text="おまかせ" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="「友達と遊ぶ」など遊び方から選ぶだけ。" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock Text="プリセット → 名前 → 作成" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChoiceButton}" Margin="0,0,8,0" Padding="18,20" Command="{Binding SelectRouteCommand}" CommandParameter="advanced">
                            <StackPanel>
                                <TextBlock Text="⚙" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource BrushAccent}"/>
                                <TextBlock Text="詳細設定" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="種別・バージョン・ポートを自分で指定。" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock Text="種別 → バージョン → 接続 → 作成" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChoiceButton}" Padding="18,20" Command="{Binding SelectRouteCommand}" CommandParameter="import">
                            <StackPanel>
                                <TextBlock Text="⇩" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource BrushAccent}"/>
                                <TextBlock Text="取り込み" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="テンプレートファイルの形式と設定を確認。" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock Text="ファイル → 内容の確認（作成は未対応）" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- 統合版: はじめる -->
                <Border Style="{StaticResource Card}" Margin="0,22,0,0"
                        Visibility="{Binding IsBedrockEdition, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="統合版サーバー (Bedrock Dedicated Server)" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="Mojang 公式のサーバーソフトを使います。Java のインストールは不要です。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Margin="0,0,0,6"><Run Text="✓ " Foreground="{DynamicResource BrushSuccess}" FontWeight="Bold"/><Run Text="遊び方を選ぶだけのおまかせ設定"/></TextBlock>
                                <TextBlock Margin="0,0,0,6"><Run Text="✓ " Foreground="{DynamicResource BrushSuccess}" FontWeight="Bold"/><Run Text="公式の最新版を自動で取得（手元の zip からも作成可）"/></TextBlock>
                                <TextBlock><Run Text="✓ " Foreground="{DynamicResource BrushSuccess}" FontWeight="Bold"/><Run Text="ポート開放・Firewall・参加許可リストもアプリから設定"/></TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,12,0,0">
                                <Run Text="最新の正式版: "/><Run Text="{Binding Bedrock.LatestReleaseText, Mode=OneWay}" FontFamily="Cascadia Mono" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="はじめる →" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                Padding="26,11" FontSize="14" Margin="16,0,0,0"
                                Command="{Binding SelectRouteCommand}" CommandParameter="bedrock"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ════ Java 版: おまかせ ════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Route, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=easy}">
                <StackPanel>
                    <TextBlock Text="用途を選択" Style="{StaticResource SectionHeading}"/>
                    <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Margin="0,8,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ServerListItem}">
                                <Setter Property="Margin" Value="4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Glyph}" FontSize="22"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontFamily="Cascadia Mono" FontSize="10.5" Margin="0,6,0,0">
                                        <Run Text="{Binding TypeId, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Ram, Mode=OneWay}"/><Run Text="MB · "/><Run Text="{Binding MaxPlayers, Mode=OneWay}"/><Run Text="人"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="サーバー名 *"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            <TextBlock Text="バージョン" Margin="0,12,0,0"/>
                            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Id" Width="240" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SelectedVersionInfo}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            <CheckBox Content="Minecraft EULA に同意する" IsChecked="{Binding EulaAccepted}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ════ Java 版: 詳細設定 ════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Route, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=advanced}">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="基本" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="サーバー名 *" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            <TextBlock Text="保存先フォルダ" Margin="0,12,0,0"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DirectoryPath}"/>
                                <Button Grid.Column="1" Content="参照" Command="{Binding BrowseDirectoryCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="サーバー種別" Margin="0,12,0,0"/>
                            <ComboBox ItemsSource="{Binding ServerTypes}" SelectedItem="{Binding SelectedServerType}" DisplayMemberPath="Label" Width="320" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            <TextBlock Text="Minecraft バージョン" Margin="0,12,0,0"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding VersionFilters}" SelectedItem="{Binding SelectedVersionFilter}" DisplayMemberPath="Label"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Id" Margin="8,0,0,0"/>
                                <Button Grid.Column="2" Content="更新" Command="{Binding RefreshVersionsCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding VersionFilterSummary}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding ModVersionHint}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="MOTD" Margin="0,12,0,0"/>
                            <TextBox Text="{Binding Motd}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="リソース" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="メモリ割り当て (Xms / Xmx MB)" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBox Text="{Binding MemoryXms}" Width="120"/>
                                <TextBlock Text=" / " VerticalAlignment="Center" Margin="6,0"/>
                                <TextBox Text="{Binding MemoryXmx}" Width="120"/>
                            </StackPanel>
                            <TextBlock Text="Java パス" Margin="0,12,0,0"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding JavaPath}"/>
                                <Button Grid.Column="1" Content="参照" Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="接続" Style="{StaticResource SectionHeading}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="ポート (TCP)"/>
                                    <TextBox Text="{Binding Port}" Width="120" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="最大人数"/>
                                    <TextBox Text="{Binding MaxPlayers}" Width="120" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Content="オンラインモード" IsChecked="{Binding OnlineMode}" Margin="0,12,0,0"/>
                            <CheckBox Content="コマンドブロックを有効化 (enable-command-block)" IsChecked="{Binding EnableCommandBlock}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="EULA" Style="{StaticResource SectionHeading}"/>
                            <CheckBox Content="Minecraft EULA に同意する" IsChecked="{Binding EulaAccepted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ════ 統合版 ════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsBedrockRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="遊び方を選ぶ" Style="{StaticResource SectionHeading}"/>
                    <ListBox ItemsSource="{Binding Bedrock.Presets}" SelectedItem="{Binding Bedrock.SelectedPreset}" Margin="-4,6,-4,0"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ServerListItem}">
                                <Setter Property="Margin" Value="4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Glyph}" FontSize="22" Foreground="{DynamicResource BrushSuccess}"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11.5"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,8,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 基本 -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,12">
                        <StackPanel>
                            <TextBlock Text="基本" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="サーバー名 *" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            <TextBlock Text="ゲーム内のサーバー一覧・LAN ゲームにこの名前で表示されます。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ゲームモード"/>
                                    <ComboBox ItemsSource="{Binding Bedrock.GameModes}" SelectedValuePath="Id" DisplayMemberPath="Label"
                                              SelectedValue="{Binding Bedrock.GameMode}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="難易度"/>
                                    <ComboBox ItemsSource="{Binding Bedrock.Difficulties}" SelectedValuePath="Id" DisplayMemberPath="Label"
                                              SelectedValue="{Binding Bedrock.Difficulty}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="最大人数"/>
                                    <TextBox Text="{Binding Bedrock.MaxPlayers}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="チート（コマンド）を許可" FontWeight="SemiBold"/>
                                        <TextBlock Text="/time や /give などが使えます。オンにすると実績は解除されません。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Bedrock.AllowCheats}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- サーバーソフト -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="サーバーソフト (BDS)" Style="{StaticResource SectionHeading}"/>
                                <Button Content="↻ 再確認" Style="{StaticResource SmallGhostButton}" HorizontalAlignment="Right"
                                        Command="{Binding Bedrock.RetryLoadVersionsCommand}"/>
                            </Grid>
                            <UniformGrid Columns="3" Margin="0,8,0,0">
                                <RadioButton Style="{StaticResource SelectableCard}" Padding="12,10" Margin="0,0,6,0" GroupName="BedrockSource"
                                              IsChecked="{Binding Bedrock.Source, Converter={StaticResource EqualsToBooleanConverter}, ConverterParameter=release, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="正式版（おすすめ）" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Bedrock.LatestReleaseText}" FontFamily="Cascadia Mono" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SelectableCard}" Padding="12,10" Margin="3,0,3,0" GroupName="BedrockSource"
                                              IsChecked="{Binding Bedrock.Source, Converter={StaticResource EqualsToBooleanConverter}, ConverterParameter=preview, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="プレビュー" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Bedrock.LatestPreviewText}" FontFamily="Cascadia Mono" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SelectableCard}" Padding="12,10" Margin="6,0,0,0" GroupName="BedrockSource"
                                              IsChecked="{Binding Bedrock.Source, Converter={StaticResource EqualsToBooleanConverter}, ConverterParameter=zip, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="手元の zip" FontWeight="SemiBold"/>
                                        <TextBlock Text="公式サイトで入手した zip" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="True"
                                         Visibility="{Binding Bedrock.IsLoadingVersions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding Bedrock.VersionStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding Bedrock.VersionStatus, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>
                            <Grid Margin="0,10,0,0"
                                  Visibility="{Binding Bedrock.Source, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=zip}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Bedrock.ZipPath, Mode=OneWay}" IsReadOnly="True" ToolTip="bedrock-server-x.xx.x.x.zip（Windows 版）"/>
                                <Button Grid.Column="1" Content="zip を選択" Command="{Binding Bedrock.BrowseZipCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="統合版はゲームとサーバーのバージョンがそろっていないと参加できません。通常は「正式版」を選んでください。"/>
                        </StackPanel>
                    </Border>

                    <!-- 接続・保存先 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="接続・保存先" Style="{StaticResource SectionHeading}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="ポート"/>
                                    <TextBox Text="{Binding Bedrock.Port}" Width="120" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="IPv6 ポート"/>
                                    <TextBox Text="{Binding Bedrock.PortV6}" Width="120" Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox Content="オンラインモード (Xbox Live 認証)" IsChecked="{Binding Bedrock.OnlineMode}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                            </StackPanel>
                            <TextBlock Text="通信方式" Margin="0,14,0,0"/>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <RadioButton Style="{StaticResource SelectableCard}" Padding="12,10" Margin="0,0,6,0" GroupName="BedrockTransport"
                                             IsChecked="{Binding Bedrock.UseRakNet}">
                                    <StackPanel>
                                        <TextBlock Text="RakNet（おすすめ）" FontWeight="SemiBold"/>
                                        <TextBlock Text="旧方式。現在はこちらの方がつながりやすいという報告が多い。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SelectableCard}" Padding="12,10" Margin="6,0,0,0" GroupName="BedrockTransport"
                                             IsChecked="{Binding Bedrock.UseNetherNet}">
                                    <StackPanel>
                                        <TextBlock Text="NetherNet" FontWeight="SemiBold"/>
                                        <TextBlock Text="新方式 (BDS の既定)。一覧に見えるのに入れない不具合の報告あり。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="RakNet では起動時に「NetherNet is the only supported transport type...」と警告が出ますが、そのまま接続できます。RakNet はクライアント 1.26.60 で廃止予定との情報があり、つながらなくなったら NetherNet に切り替えてください（サーバー設定から変更できます）。家の外から参加してもらう設定は、作成後に「接続・公開」画面から行えます。"/>
                            <TextBlock Text="保存先フォルダ" Margin="0,12,0,0"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DirectoryPath}"/>
                                <Button Grid.Column="1" Content="参照" Command="{Binding BrowseDirectoryCommand}" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 同意 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="利用規約" Style="{StaticResource SectionHeading}"/>
                            <CheckBox IsChecked="{Binding EulaAccepted}" Margin="0,8,0,0">
                                <TextBlock TextWrapping="Wrap">
                                    <Hyperlink Foreground="{DynamicResource BrushAccent}" NavigateUri="https://www.minecraft.net/eula" RequestNavigate="OnRequestNavigate">Minecraft EULA</Hyperlink>
                                    <Run Text="と"/>
                                    <Hyperlink Foreground="{DynamicResource BrushAccent}" NavigateUri="https://go.microsoft.com/fwlink/?LinkId=521839" RequestNavigate="OnRequestNavigate">プライバシーポリシー</Hyperlink>
                                    <Run Text="に同意する"/>
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Text="統合版サーバーは Mojang 公式サイト (minecraft.net) からダウンロードされます。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ════ 取り込み(近日対応) ════ -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding Route, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=import}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" DataContext="{Binding TemplateInspection}">
                        <TextBlock Text="テンプレートの内容を確認" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text=".maipilot-template.json の形式確認のみ対応しています。テンプレートからの作成、MODの取得・追加はまだできません。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="テンプレートを選ぶ…" Click="OnInspectTemplate" Padding="16,8"/>
                            <Button Content="確認を取り消す" Click="OnCancelTemplateInspection" IsEnabled="{Binding IsBusy}" Margin="10,0,0,0" Padding="16,8"/>
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <TextBlock Text="作成したい場合は、入口に戻って「おまかせ」または「詳細設定」を選んでください。確認したテンプレートは自動で適用されません。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,20,0,0"/>
                        <Expander Header="実際のMODと前提MODを確認（Fabric / Modrinth）" Margin="0,20,0,0"
                                  DataContext="{Binding DataContext.ModInspection, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="選んだJARのハッシュをModrinthへ照会し、配布情報・実ファイルの宣言を確認します。必要な正規ファイルを一時取得しますが、MODの導入・実行はしません。" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="確認するMODを選ぶ…" Click="OnSelectInspectionMods" Padding="12,6"/>
                                    <Button Content="導入済みMODと比較…" Click="OnSelectInstalledMods" Padding="12,6" Margin="8,0,0,0"/>
                                    <Button Content="ファイル選択を解除" Click="OnClearInspectionMods" Padding="12,6" Margin="8,0,0,0"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding FileSelection}" Margin="0,8,0,0"/>
                                <TextBlock Text="または、確認するModrinth固定版ID（複数はカンマ区切り）" Margin="0,12,0,0"/>
                                <TextBox Text="{Binding VersionIds, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096"/>
                                <TextBlock Text="配布元APIが要求する前提MODの固定版ID（必要な場合のみ。最新版を自動選択しません）" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding DependencyVersionIds, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096"/>
                                <TextBlock Text="確認対象の版（例示の初期値です。実際の環境に合わせて変更してください）" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <UniformGrid Columns="3" Margin="0,4,0,0">
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Minecraft"/><TextBox Text="{Binding MinecraftVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="96"/></StackPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Fabric Loader"/><TextBox Text="{Binding LoaderVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="96"/></StackPanel>
                                    <StackPanel><TextBlock Text="Java"/><TextBox Text="{Binding JavaVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="96"/></StackPanel>
                                </UniformGrid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="配布元と実ファイルを確認" Click="OnInspectMods" Padding="16,8"/>
                                    <Button Content="確認を取り消す" Click="OnCancelModInspection" IsEnabled="{Binding IsBusy}" Padding="16,8" Margin="8,0,0,0"/>
                                </WrapPanel>
                                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <Expander Header="検出内容・依存経路・ファイル識別情報" Margin="0,8,0,0">
                                    <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="400" VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- フッター -->
        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource SurfacePanel}"
                Visibility="{Binding IsRouteSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProgressMessage}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressStep}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" Margin="8,0,0,0"/>
                    </Grid>
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushError}" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsBedrockRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource BrushSuccessSoft}" BorderBrush="{DynamicResource BrushSuccess}">
                            <TextBlock Text="統合版" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}"/>
                        </Border>
                        <TextBlock Text="{Binding Bedrock.SelectedVersionText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="キャンセル" Command="{Binding CancelCommand}" Width="110"/>
                        <Button Content="✨ サーバーを作成" Command="{Binding CreateCommand}" Width="170" Margin="10,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Route}" Value="import">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
