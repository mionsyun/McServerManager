<Window x:Class="McServerManager.Views.ParticipantExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="参加者向け案内ZIP - MaiPilot"
        Width="920" Height="820" MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="参加者向け案内ZIP" Style="{StaticResource ScreenTitle}"/>
            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                       Text="Free / Pro 共通。テンプレートに明記された参加者用の構成を確認し、MOD 一覧と説明を保存できます。"/>
        </StackPanel>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
                <Border x:Name="FileWarningPanel" Style="{StaticResource WarnBanner}" Visibility="Collapsed" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="保存処理の一時ファイルが残っています" FontWeight="SemiBold" Foreground="{DynamicResource BrushWarning}"/>
                        <TextBlock Text="以前の保存処理で、ZIP の保存と一時ファイルの削除に失敗しました。下の場所を確認してください。その後の保存結果とは別の注意事項です。この一時ファイルを参加者に配布しないでください。"
                                   TextWrapping="Wrap" Margin="0,5,0,8"/>
                        <TextBox x:Name="FileWarningPaths" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                 AutomationProperties.Name="削除できなかった作業用ファイルの場所"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfacePanel}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="1  テンプレートから参加者用の構成を読み込む" Style="{StaticResource SectionHeading}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,12"
                                   Text="管理者から受け取った MaiPilot テンプレートを選んでください。テンプレート内の明示的なクライアント定義だけを使い、サーバーの MOD 一覧からは推測しません。"/>
                        <StackPanel x:Name="ImportControls">
                            <Button Content="テンプレートから読み込む…" Click="OnImportTemplate"
                                    IsEnabled="{Binding CapabilityAvailable}" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Padding="16,9"/>
                            <TextBlock Text="対応: UTF-8 の .maipilot-template.json（最大 1 MiB）。参加者用の定義が明記されている必要があります。"
                                       Margin="0,9,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
                            <Expander Header="詳細設定: クライアント定義 JSON を直接読み込む" Margin="0,14,0,0">
                                <StackPanel Margin="0,9,0,0">
                                    <TextBlock Text="既存の参加者用 JSON がある管理者向けです。テンプレートがあれば、上の「テンプレートから読み込む」を使ってください。"
                                               TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,9"/>
                                    <Button x:Name="ImportButton" Content="クライアント定義 JSON を選ぶ…" Click="OnImport"
                                            IsEnabled="{Binding CapabilityAvailable}" Style="{StaticResource BaseButton}"
                                            HorizontalAlignment="Left" Padding="16,9"/>
                                    <TextBlock Text="対応: UTF-8 の .json（最大 256 KiB / MOD 256 件）。Modrinth、Fabric / Forge の明示的な定義。CurseForge は未対応です。"
                                               Margin="0,9,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <TextBlock x:Name="SelectedFileText" Text="ファイル未選択"
                                   Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
                        <TextBlock x:Name="TemplateStatusText" Visibility="Collapsed" Margin="0,9,0,0"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PendingBanner}" Margin="0,0,0,14"
                        Visibility="{Binding HasDefinition, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="テンプレートに参加者用の定義がない場合" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="案内 ZIP は作れません。管理者に、Minecraft・ローダー・Java の指定と、参加者が使う MOD の正確な版、必須 / 任意を明記したクライアント定義付きテンプレートを依頼してください。この画面では定義の作成・編集はできません。既存の参加者用 JSON がある場合だけ「詳細設定」から読み込めます。"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WarnBanner}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="この ZIP は案内資料です" FontWeight="SemiBold" Foreground="{DynamicResource BrushWarning}"/>
                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="MOD 本体のダウンロード・同梱・インストールは行いません。README.txt、mods.txt、manifest.json のみを保存します。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="確認するのは入力形式のみです。提供元との照合、依存 MOD の不足、クライアント対応、Minecraft・ローダー・Java の動作互換性は未検証です。MOD 名・版・必須 / 任意は定義の申告値です。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="公式 URL は Modrinth の ID から生成した未照合の参照先です。各ページの存在・公開状態・ダウンロード権限は確認していません。渡す前に管理者自身で内容を確認してください。"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfacePanel}"
                        Visibility="{Binding Details, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
                    <StackPanel>
                        <TextBlock Text="2  出力する内容をすべて確認する" Style="{StaticResource SectionHeading}"
                                   Visibility="{Binding HasDefinition, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="読み込めない理由" Style="{StaticResource SectionHeading}"
                                   Visibility="{Binding HasDefinition, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding DefinitionName}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Visibility="{Binding HasDefinition, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="定義に記載された実行環境と MOD 一覧です。末尾までスクロールして確認してください。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,10"
                                   Visibility="{Binding HasDefinition, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="8"
                                 AutomationProperties.Name="参加者用の実行環境と全 MOD の確認内容"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource SurfacePanel}">
            <StackPanel>
                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite"/>
                </ScrollViewer>
                <StackPanel x:Name="BusyStatusPanel" Visibility="Collapsed" Margin="0,9,0,0">
                    <TextBlock x:Name="OperationStatusText" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
                    <ProgressBar IsIndeterminate="True" Margin="0,8,0,0"
                                 AutomationProperties.Name="参加者向け案内ZIPの処理中"/>
                </StackPanel>
                <StackPanel x:Name="AcknowledgementControls" Margin="0,12,0,0">
                    <CheckBox IsChecked="{Binding AcknowledgedLimitations}" IsEnabled="{Binding CanAcknowledge}"
                              VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch">
                        <TextBlock TextWrapping="Wrap"
                                   Text="一覧と実行環境を確認しました。提供元・依存関係・互換性は未検証で、自動ダウンロード・導入を行わない案内資料であることを理解しました。"/>
                    </CheckBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="既存ファイルは上書きしません。新しいファイル名で保存してください。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelOperationButton" Content="処理を中止" Click="OnCancelOperation"
                        IsEnabled="False" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                <Button x:Name="CloseButton" Content="閉じる" Click="OnClose"
                        Style="{StaticResource BaseButton}" Margin="0,0,8,0"/>
                <StackPanel x:Name="ExportControls">
                    <Button Content="3  案内ZIPを保存…" Click="OnSave" IsEnabled="{Binding CanExport}"
                            Style="{StaticResource PrimaryButton}" Padding="16,9"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
