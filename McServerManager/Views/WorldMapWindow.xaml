<Window x:Class="McServerManager.Views.WorldMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ワールドマッププレビュー"
        Width="960" Height="720"
        MinWidth="480" MinHeight="360">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ResetZoomCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <WrapPanel>
                <Button Content="再読み込み"
                        Command="{Binding ReloadCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"/>
                <Separator Background="{DynamicResource BrushBorder}"
                           Width="1" Height="20"
                           Margin="4,0,8,0"/>
                <Button Content="拡大"
                        Command="{Binding ZoomInCommand}"
                        Width="52"
                        Margin="0,0,4,0"/>
                <Button Content="縮小"
                        Command="{Binding ZoomOutCommand}"
                        Width="52"
                        Margin="0,0,4,0"/>
                <Button Content="1:1"
                        Command="{Binding ResetZoomCommand}"
                        Width="44"
                        Margin="0,0,8,0"/>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource MutedText}">
                    <Run Text="倍率:"/>
                    <Run Text="{Binding Scale, StringFormat={}{0:P0}, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource MutedText}"
                           Margin="10,0,0,0"
                           Text="Ctrl+ホイール: ズーム / ドラッグ: 移動"/>
            </WrapPanel>
        </Border>

        <ScrollViewer x:Name="MapScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#1A1A1A"
                      PreviewMouseWheel="MapScrollViewer_OnPreviewMouseWheel"
                      PreviewMouseLeftButtonDown="MapScrollViewer_OnPreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="MapScrollViewer_OnPreviewMouseLeftButtonUp"
                      PreviewMouseMove="MapScrollViewer_OnPreviewMouseMove"
                      MouseLeave="MapScrollViewer_OnMouseLeave">
            <Grid x:Name="MapContent">
                <Image Source="{Binding MapImage}"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Image.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                    </Image.LayoutTransform>
                </Image>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedText}"
                           TextAlignment="Center"
                           Visibility="{Binding ShowPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="マップが表示されていません"/>
                    <LineBreak/>
                    <Run Text="再読み込みボタンで生成してください"/>
                </TextBlock>

                <Border Background="#B0000000"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="レンダリング中..."
                                   Foreground="White"
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True"
                                     Width="240"
                                     Height="6"
                                     Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource MutedText}"/>
        </Border>
    </Grid>
</Window>
