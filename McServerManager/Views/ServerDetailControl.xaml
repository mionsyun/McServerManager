<UserControl x:Class="McServerManager.Views.ServerDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Border Background="{DynamicResource BrushAccentSoft}"
                                BorderBrush="{DynamicResource BrushAccent}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,3"
                                Margin="0,0,6,4">
                            <TextBlock FontSize="12">
                                <Run Text="●" Foreground="{DynamicResource BrushAccent}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{DynamicResource BrushAccent}"/>
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,6,4">
                            <TextBlock Text="{Binding ServerType, StringFormat=🛠️ {0}}" FontSize="12"/>
                        </Border>
                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,6,4">
                            <TextBlock Text="{Binding Port, StringFormat=🔌 {0}}" FontSize="12"/>
                        </Border>
                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Version, StringFormat=🏷️ {0}}" FontSize="12"/>
                        </Border>
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,6,4">
                            <TextBlock Text="{Binding CpuUsagePercent, StringFormat=💻 CPU {0:F0}%}" FontSize="12"/>
                        </Border>
                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,6,4">
                            <TextBlock Text="{Binding MemoryUsageMb, StringFormat=🧠 RAM {0:F0}MB}" FontSize="12"/>
                        </Border>
                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,6,4">
                            <TextBlock Text="{Binding GpuUsageDisplayText, StringFormat=🎮 GPU {0}}" FontSize="12"/>
                        </Border>
                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,0,4">
                            <TextBlock Text="{Binding PlayerCountText, StringFormat=👤 {0}}" FontSize="12"/>
                        </Border>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="⏰ 最終起動" Style="{StaticResource MutedText}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LastStartedAtText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📂 保存先" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ServerDirectory}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                        <Button Grid.Column="2" Content="開く" Command="{Binding OpenServerDirectoryCommand}" Margin="8,0,0,0" Width="80"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartServerButton" Content="{Binding StartButtonLabel}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Width="96" Margin="0,0,8,0" Height="36"/>
                    <Button Content="{Binding StopButtonLabel}" Command="{Binding StopCommand}" Width="96" Margin="0,0,8,0" Height="36"/>
                    <Button Content="{Binding RestartButtonLabel}" Command="{Binding RestartCommand}" Width="96" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="ServerTabs" Grid.Row="1">
            <TabItem Header="コンソール">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource BrushTerminalBg}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                        <ListBox x:Name="LogListBox"
                                 ItemsSource="{Binding Logs}"
                                 FontFamily="Cascadia Mono"
                                 FontSize="12"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource BrushTerminalFg}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 HorizontalContentAlignment="Left"
                                 VirtualizingStackPanel.IsVirtualizing="False"
                                 PreviewMouseWheel="LogListBox_OnPreviewMouseWheel"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendCommandCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="送信" Command="{Binding SendCommandCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Width="90"/>
                    </Grid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="📄 ログ出力" Command="{Binding ExportLogsCommand}" Margin="0,0,8,0"
                                ToolTip="コンソールログをファイルに保存します"/>
                        <Button Content="📁 ログフォルダ" Command="{Binding OpenLogsDirectoryCommand}" Margin="0,0,8,0"
                                ToolTip="logs フォルダをエクスプローラーで開きます"/>
                        <Button Content="⚠ クラッシュレポート" Command="{Binding OpenCrashReportsCommand}"
                                ToolTip="crash-reports フォルダをエクスプローラーで開きます"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="監視">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource SurfacePanel}">
                            <StackPanel>
                                <TextBlock Text="📊 稼働モニター" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="サーバープロセスの使用率を定期更新しています。"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CpuUsagePercent, Mode=OneWay}" Height="8" Margin="8,0,8,0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CpuUsageDisplayText}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="RAM" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MemoryUsagePercent, Mode=OneWay}" Height="8" Margin="8,10,8,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MemoryUsageDisplayText}" VerticalAlignment="Center" Margin="0,10,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="GPU" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    <ProgressBar Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding GpuUsagePercent, Mode=OneWay}" Height="8" Margin="8,10,8,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding GpuUsageDisplayText}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                </Grid>

                                <TextBlock Text="{Binding GpuMonitorHint}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="設定">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="SettingsScrollViewer"
                                  Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="SettingsScrollViewer_OnPreviewMouseWheel">
                        <StackPanel Margin="12,12,12,8">
                        <Border Style="{StaticResource SurfacePanel}">
                            <StackPanel>
                                <TextBlock Text="⚙️ サーバー設定" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="稼働中の変更は保存できますが反映は再起動後です。" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                <TextBlock Text="⚠ 再起動が必要" Foreground="{DynamicResource BrushError}" FontWeight="SemiBold" Margin="0,8,0,0"
                                           Visibility="{Binding RestartRequired, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

                                <Grid DataContext="{Binding Settings}" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="サーバーポート"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ServerPort}" Width="120"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="最大人数" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxPlayers}" Width="120" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="MOTD" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Motd}" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="オンラインモード" Margin="0,8,0,0"/>
                                    <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding OnlineMode}" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="コマンドブロック" Margin="0,8,0,0"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0">
                                        <CheckBox IsChecked="{Binding EnableCommandBlock}" Content="enable-command-block を有効化"/>
                                        <TextBlock Text="配布マップ・コマンド演出を使うワールドは有効化推奨です。"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="難易度" Margin="0,8,0,0"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" SelectedValue="{Binding Difficulty}" SelectedValuePath="Content" Width="160" Margin="0,8,0,0">
                                        <ComboBoxItem Content="peaceful"/>
                                        <ComboBoxItem Content="easy"/>
                                        <ComboBoxItem Content="normal"/>
                                        <ComboBoxItem Content="hard"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ゲームモード" Margin="0,8,0,0"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1" SelectedValue="{Binding GameMode}" SelectedValuePath="Content" Width="160" Margin="0,8,0,0">
                                        <ComboBoxItem Content="survival"/>
                                        <ComboBoxItem Content="creative"/>
                                        <ComboBoxItem Content="adventure"/>
                                        <ComboBoxItem Content="spectator"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="PvP" Margin="0,8,0,0"/>
                                    <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding Pvp}" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="描画距離" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ViewDistance}" Width="120" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="スポーン保護" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SpawnProtection}" Width="120" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="ワールド名" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding LevelName}" Width="220" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="シード" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Seed}" Width="220" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Java パス" Margin="0,8,0,0"/>
                                    <StackPanel Grid.Row="12" Grid.Column="1" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="JavaPathTextBox" Text="{Binding DataContext.JavaPath, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <Button Grid.Column="1" Content="参照" Command="{Binding DataContext.BrowseJavaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0"/>
                                            <Button Grid.Column="2" Content="自動検出" Command="{Binding DataContext.DetectJavaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0"/>
                                        </Grid>
                                        <Border Background="{DynamicResource BrushAccentSoft}"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                Margin="0,6,0,0">
                                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}">
                                                <Run Text="💡 Javaが未導入の場合は"/><LineBreak/>
                                                <Run Text="  1. https://adoptium.net から Temurin (LTS) をダウンロード"/><LineBreak/>
                                                <Run Text="  2. インストーラーで「PATH に追加」にチェック"/><LineBreak/>
                                                <Run Text="  3. 「自動検出」ボタンで自動設定されます"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="🔄 クラッシュ復帰" FontWeight="SemiBold" FontSize="14"/>
                                <CheckBox Content="クラッシュ時に自動再起動" IsChecked="{Binding AutoRestartOnCrash}" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="再起動までの秒数" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding AutoRestartDelaySeconds}" Width="80"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="🚀 起動安定化" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="起動方式を手動指定したり、プリセットでメモリ/GC引数を適用できます。" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="起動方式" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LaunchModes}"
                                              SelectedItem="{Binding SelectedLaunchMode}"
                                              DisplayMemberPath="Label"/>
                                </Grid>
                                <TextBlock Text="{Binding LaunchModeDescription}" Style="{StaticResource MutedText}" Margin="120,4,0,0"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="プリセット" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding StartupPresets}"
                                              SelectedItem="{Binding SelectedStartupPreset}"
                                              DisplayMemberPath="Label"/>
                                    <Button Grid.Column="2" Content="適用" Command="{Binding ApplyStartupPresetCommand}" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Xms (MB)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding MemoryXmsMb}" Width="120"/>
                                    <TextBlock Grid.Column="2" Text="Xmx (MB)" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding MemoryXmxMb}" Width="120"/>
                                </Grid>
                                <TextBlock Text="256〜131072 MB の範囲で入力してください。Xms ≤ Xmx。"
                                           Style="{StaticResource MutedText}"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="追加Java引数" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding JavaExtraArguments}"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="ヘルスチェック実行" Command="{Binding RunHealthCheckCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="👑 OP 管理" FontWeight="SemiBold" FontSize="14"/>
                                    <ListBox ItemsSource="{Binding Ops}" SelectedItem="{Binding SelectedOp}" Margin="0,8,0,0" Height="160">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Level, StringFormat=Level {0}}" Style="{StaticResource MutedText}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewOpName}"/>
                                        <Button Grid.Column="1" Content="追加" Command="{Binding AddOpCommand}" Margin="8,0,0,0"/>
                                        <Button Grid.Column="2" Content="削除" Command="{Binding RemoveOpCommand}" Margin="8,0,0,0"/>
                                    </Grid>
                                    <Button Content="再読込" Command="{Binding ReloadPermissionsCommand}" Margin="0,8,0,0" Width="100"/>
                                    <TextBlock Text="{Binding PermissionsStatusMessage}"
                                               Foreground="{DynamicResource BrushAccent}"
                                               FontSize="12"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding PermissionsStatusMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}, FallbackValue=Collapsed}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="📝 ホワイトリスト" FontWeight="SemiBold" FontSize="14"/>
                                    <ListBox ItemsSource="{Binding Whitelist}" SelectedItem="{Binding SelectedWhitelist}" Margin="0,8,0,0" Height="160">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewWhitelistName}"/>
                                        <Button Grid.Column="1" Content="追加" Command="{Binding AddWhitelistCommand}" Margin="8,0,0,0"/>
                                        <Button Grid.Column="2" Content="削除" Command="{Binding RemoveWhitelistCommand}" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Background="{DynamicResource BrushCard}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="変更後は「設定を保存」を押してください。"
                                           Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding SettingsSavedMessage}"
                                           Foreground="{DynamicResource BrushAccent}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding SettingsSavedMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}, FallbackValue=Collapsed}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="設定を保存"
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="140"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="WorldTab" Header="ワールド">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="12" DataContext="{Binding World}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SurfacePanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="🌍 運用中ワールド" FontWeight="SemiBold" FontSize="14"/>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="現在:" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource BrushCard}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="{Binding CurrentWorldName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Worlds}"
                                          SelectedItem="{Binding SelectedWorld}"
                                          Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Content="切り替え"
                                        Command="{Binding SwitchWorldCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="100"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Text="{Binding WorldSwitchHint}" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                            <WrapPanel Grid.Row="4" Margin="0,10,0,0">
                                <Button Content="🗺️ マップ表示" Command="{Binding OpenWorldMapCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                                <Button Content="フォルダを開く" Command="{Binding OpenSelectedWorldDirectoryCommand}" Margin="0,0,8,8"/>
                                <Button Content="一覧更新" Command="{Binding RefreshWorldsCommand}" Margin="0,0,8,8"/>
                                <Button Content="選択中を削除" Command="{Binding DeleteWorldCommand}" Margin="0,0,0,8"/>
                            </WrapPanel>

                            <ListBox Grid.Row="5"
                                     ItemsSource="{Binding Worlds}"
                                     SelectedItem="{Binding SelectedWorld}"
                                     Margin="0,4,0,0"/>

                            <Grid Grid.Row="6" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewWorldName}"/>
                                <Button Grid.Column="1" Content="新規作成" Command="{Binding CreateWorldCommand}" Margin="8,0,0,0" Width="100"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SurfacePanel}">
                        <StackPanel>
                            <TextBlock Text="💾 ワールドバックアップ" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="停止中にローカルワールドのバックアップ作成・復元ができます。"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>

                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="バックアップ作成"
                                        Command="{Binding CreateWorldBackupCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8"/>
                                <Button Content="一覧更新"
                                        Command="{Binding RefreshWorldBackupsCommand}"
                                        Margin="0,0,8,8"/>
                                <Button Content="フォルダを開く"
                                        Command="{Binding OpenBackupsDirectoryCommand}"
                                        Margin="0,0,0,8"/>
                            </WrapPanel>

                            <TextBlock Text="復元先ワールド名" Margin="0,4,0,4"/>
                            <TextBox Text="{Binding RestoreBackupWorldName}"/>

                            <CheckBox Content="復元前に現在ワールドを自動バックアップ"
                                      IsChecked="{Binding CreateBackupBeforeRestore}"
                                      Margin="0,8,0,0"/>

                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="選択バックアップを復元"
                                        Command="{Binding RestoreWorldBackupCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8"/>
                                <Button Content="選択バックアップ削除"
                                        Command="{Binding DeleteWorldBackupCommand}"
                                        Margin="0,0,0,8"/>
                            </WrapPanel>

                            <ListBox ItemsSource="{Binding WorldBackups}"
                                     SelectedItem="{Binding SelectedWorldBackup}"
                                     Margin="0,4,0,0"
                                     MaxHeight="170">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2,0,2">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel Margin="0,2,0,0">
                                                <TextBlock Text="{Binding WorldName, StringFormat=ワールド: {0}}" Style="{StaticResource MutedText}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding CreatedAtText}" Style="{StaticResource MutedText}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Background="{DynamicResource BrushCard}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,10,0,0">
                                <TextBlock Text="{Binding WorldBackupStatus}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Separator Margin="0,14,0,14"/>

                            <TextBlock Text="🗺️ 配布マップ導入 (.zip)" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="ZIPを選択し、導入先ワールド名を指定して取り込みます。"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource BrushWarningSoft}"
                                    BorderBrush="{DynamicResource BrushWarning}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                                    <Run Text="配布マップ導入時にコマンドブロック有効化の確認を表示します。"/><LineBreak/>
                                    <Run Text="有効化しない場合、ギミックが動作しない可能性があります。"/>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="ZIPファイル" Margin="0,10,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MapArchivePath, Mode=OneWay}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="選択" Command="{Binding BrowseMapArchiveCommand}" Margin="8,0,0,0" Width="100"/>
                            </Grid>

                            <TextBlock Text="導入元フォルダ" Margin="0,10,0,4"/>
                            <ComboBox ItemsSource="{Binding MapArchiveCandidates}"
                                      SelectedItem="{Binding SelectedMapArchiveCandidate}"
                                      DisplayMemberPath="DisplayName"/>
                            <TextBlock Text="{Binding MapArchiveSourceHint}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="導入先ワールド名" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding MapImportWorldName}"/>

                            <StackPanel Margin="0,10,0,0">
                                <CheckBox Content="同名ワールドは上書きして導入"
                                          IsChecked="{Binding ReplaceWorldOnMapImport}"/>

                                <Button Content="配布マップを導入"
                                        Command="{Binding ImportMapArchiveCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="170"
                                        Margin="0,10,0,0"/>

                                <Border Background="{DynamicResource BrushCard}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,10,0,0">
                                    <TextBlock Text="{Binding MapImportStatus}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AddonTab" Header="MOD/プラグイン">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12" DataContext="{Binding Addon}">

                    <Border Style="{StaticResource SurfacePanel}">
                        <StackPanel>
                            <TextBlock Text="🧰 管理対象" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding AddonStatus}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding AddonImportReview, StringFormat=追加前チェック: {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            <ProgressBar Height="6"
                                         Margin="0,8,0,0"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsAddonBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding AddonProgressMessage}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding IsAddonBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding AddonCategoryName, StringFormat=種別: {0}}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding AddonActiveDirectory, StringFormat=有効: {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AddonDisabledDirectory, StringFormat=無効: {0}}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AddonGuideText}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="🔍 Modrinth 検索" FontWeight="SemiBold" FontSize="14"/>

                            <!-- 検索バー -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding AddonSearchQuery, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchAddonCatalogCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Content="🔍 検索" Command="{Binding SearchAddonCatalogCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="16,7"/>
                                <Button Grid.Column="2" Content="🌐 ページを開く" Command="{Binding OpenAddonCatalogPageCommand}" Margin="8,0,0,0" Padding="12,7"/>
                            </Grid>

                            <TextBlock Text="{Binding AddonCatalogStatus}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>

                            <!-- 検索結果リスト -->
                            <ListBox ItemsSource="{Binding AddonSearchResults}" SelectedItem="{Binding SelectedAddonSearchResult}"
                                     MaxHeight="320" Margin="0,8,0,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="11.5"
                                                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="80">
                                                    <TextBlock Text="{Binding DownloadCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="downloads" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="追加" Command="{Binding AddAddonsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                                <Button Content="有効化" Command="{Binding EnableAddonCommand}" Margin="0,0,8,8"/>
                                <Button Content="無効化" Command="{Binding DisableAddonCommand}" Margin="0,0,8,8"/>
                                <Button Content="削除" Command="{Binding DeleteAddonCommand}" Margin="0,0,8,8"/>
                                <Button Content="フォルダを開く" Command="{Binding OpenAddonsDirectoryCommand}" Margin="0,0,8,8"/>
                                <Button Content="一覧更新" Command="{Binding RefreshAddonsCommand}" Margin="0,0,0,8"/>
                            </WrapPanel>

                            <ListBox ItemsSource="{Binding Addons}" SelectedItem="{Binding SelectedAddon}" Margin="0,8,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FileSizeBytes, StringFormat=サイズ: {0:N0} bytes}" Style="{StaticResource MutedText}"/>
                                                <TextBlock Text="{Binding LastUpdatedAt, StringFormat=更新: {0:yyyy/MM/dd HH:mm}}" Style="{StaticResource MutedText}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource BrushSurface}"
                                                    BorderBrush="{DynamicResource BrushBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EnabledText}" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="2"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,12,0,0"
                            AllowDrop="True"
                            DragOver="AddonDropZone_OnDragOver"
                            Drop="AddonDropZone_OnDrop">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📥" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="ここに .jar ファイル（またはフォルダ）をドラッグ＆ドロップして追加"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="バージョン">
                <StackPanel Margin="12">
                    <Border Style="{StaticResource SurfacePanel}">
                        <StackPanel>
                            <TextBlock Text="📦 バージョン管理" FontWeight="SemiBold" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="一覧更新" Command="{Binding LoadVersionsCommand}" Width="120"
                                        ToolTip="Mojang からバージョン一覧を再取得します"/>
                                <TextBlock Text="現在:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Version}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="取得中..." Margin="12,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource MutedText}" FontSize="12"
                                           Visibility="{Binding IsVersionsLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            </StackPanel>
                            <ProgressBar Height="3"
                                         Margin="0,6,0,0"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsVersionsLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding VersionFilters}"
                                          SelectedItem="{Binding SelectedVersionFilter}"
                                          DisplayMemberPath="Label"/>
                                <ComboBox Grid.Column="1"
                                          Margin="8,0,0,0"
                                          ItemsSource="{Binding FilteredAvailableVersions}"
                                          SelectedItem="{Binding SelectedVersion}"
                                          DisplayMemberPath="Id"/>
                            </Grid>
                            <TextBlock Text="{Binding VersionFilterSummary}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding SelectedVersionInfo}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="変更" Command="{Binding ChangeVersionCommand}" Width="100"/>
                                <Button Content="再ダウンロード" Command="{Binding RedownloadJarCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="変更前にバックアップを作成します。Forge/Fabric は正規版を推奨します。"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="NetworkTab" Header="ネットワーク">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" DataContext="{Binding Network}">
                        <Border x:Name="FirewallSection" Style="{StaticResource SurfacePanel}">
                            <StackPanel>
                                <TextBlock Text="🛡️ Firewall 受信ルール" FontWeight="SemiBold" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="作成" Command="{Binding CreateFirewallRuleCommand}" Width="90"/>
                                    <Button Content="削除" Command="{Binding DeleteFirewallRuleCommand}" Margin="8,0,0,0" Width="90"/>
                                    <Button Content="再作成" Command="{Binding RecreateFirewallRuleCommand}" Margin="8,0,0,0" Width="90"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="🔗 UPnP ポート操作" FontWeight="SemiBold" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="開放" Command="{Binding OpenPortCommand}" Width="110"/>
                                    <Button Content="閉鎖" Command="{Binding ClosePortCommand}" Margin="8,0,0,0" Width="110"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="🌐 アドレス" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="LAN IP" Style="{StaticResource MutedText}" Margin="0,8,0,4"/>
                                <ItemsControl ItemsSource="{Binding LanIpAddresses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="グローバル IP" Style="{StaticResource MutedText}" Margin="0,12,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="取得" Command="{Binding RefreshPublicIpCommand}" Width="90"/>
                                    <TextBlock Text="{Binding PublicIp}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PublicIpStatus}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                                </StackPanel>

                                <TextBlock Text="共有アドレス" Style="{StaticResource MutedText}" Margin="0,12,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource BrushCard}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,6">
                                        <TextBlock x:Name="ShareAddressText" FontWeight="SemiBold" FontSize="14"
                                                   Text="{Binding PublicIp}"/>
                                    </Border>
                                    <Button Content="コピー" Command="{Binding CopyShareAddressCommand}" Margin="8,0,0,0" Width="80"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="✅ 外部公開チェックリスト" FontWeight="SemiBold" FontSize="14"/>
                                <ItemsControl ItemsSource="{Binding ExternalChecklist}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="-  {Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ResourcePackTab" Header="リソースパック">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" DataContext="{Binding ResourcePack}">

                        <!-- 概要カード -->
                        <Border Style="{StaticResource SurfacePanel}">
                            <StackPanel>
                                <TextBlock Text="📦 リソースパック自動配布" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource MutedText}">
                                    リソースパック（テクスチャ・サウンドのカスタマイズZIP）をプレイヤーに自動ダウンロードさせる機能です。
                                    URLを server.properties に書き込むことで、サーバー参加時にプレイヤーへ自動配布されます。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- ファイル選択 -->
                        <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="📦 リソースパック選択" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="配布したいリソースパック（ZIP形式）を選択してください。"
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Background="{DynamicResource BrushCard}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,6"
                                            MinWidth="260">
                                        <TextBlock Text="{Binding ResourcePackFileName}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Content="参照..." Command="{Binding BrowseFileCommand}" Margin="8,0,0,0" Width="90"/>
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding Sha1Hash, Converter={StaticResource NullOrEmptyToCollapsedConverter}, FallbackValue=Collapsed}">
                                    <TextBlock Text="SHA-1 ハッシュ" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource BrushCard}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,6">
                                            <TextBlock Text="{Binding Sha1Hash}"
                                                       FontFamily="Cascadia Mono"
                                                       FontSize="12"/>
                                        </Border>
                                        <Button Content="コピー" Command="{Binding CopySha1Command}" Margin="8,0,0,0" Width="80"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 配信設定 -->
                        <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒 配信設定" FontWeight="SemiBold" FontSize="14"/>
                                    <Border Background="{DynamicResource BrushAccentSoft}"
                                            BorderBrush="{DynamicResource BrushAccent}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="6,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="HTTPS推奨" FontSize="11" Foreground="{DynamicResource BrushAccent}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="MinecraftはHTTPSがほぼ必須です（HTTPだとバージョンによってブロックされます）。アカウント不要・無料のCloudflareトンネルを使用します。初回のみ約25MBダウンロード。"
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="配信ポート:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="🔒 HTTPS配信を開始" Command="{Binding StartHttpsDistributionCommand}"
                                            Style="{StaticResource PrimaryButton}" Width="160"/>
                                    <Button Content="HTTP のみ" Command="{Binding StartServerCommand}"
                                            Margin="8,0,0,0" Width="100"
                                            ToolTip="ポート開放が必要。Minecraftの新しいバージョンではブロックされる場合があります。"/>
                                    <Button Content="■ 停止" Command="{Binding StopServerCommand}" Margin="8,0,0,0" Width="80"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsTunnelRunning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="HTTPS トンネル接続中" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="{DynamicResource BrushAccent}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}, FallbackValue=Collapsed}"/>
                                <Expander Header="UPnP ポート操作（HTTP直接接続用）" Margin="0,12,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="HTTPS不使用でHTTP直接接続を使う場合、ルーターのポートをUPnPで開放します。"
                                                   Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="開放" Command="{Binding OpenPortCommand}" Width="110"/>
                                            <Button Content="閉鎖" Command="{Binding ClosePortCommand}" Margin="8,0,0,0" Width="110"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- グローバルIP / URL -->
                        <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="🔗 配信URL" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="グローバルIPを取得してリソースパックURLを確認します。ルーターのポート開放が必要です。"
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                <TextBlock Text="グローバル IP" Style="{StaticResource MutedText}" Margin="0,10,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="取得" Command="{Binding RefreshPublicIpCommand}" Width="90"/>
                                    <TextBlock Text="{Binding PublicIp}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Text="リソースパック URL" Style="{StaticResource MutedText}" Margin="0,12,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource BrushCard}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,6"
                                            MinWidth="260">
                                        <TextBlock Text="{Binding ResourcePackUrl}"
                                                   FontFamily="Cascadia Mono"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Content="コピー" Command="{Binding CopyUrlCommand}" Margin="8,0,0,0" Width="80"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- server.properties 適用 -->
                        <Border Style="{StaticResource SurfacePanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="⚙️ server.properties 連携" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="URL と SHA-1 を server.properties に書き込みます。サーバー再起動後に反映されます。"
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <Button Content="server.properties に適用" Command="{Binding ApplyToPropertiesCommand}"
                                        Style="{StaticResource PrimaryButton}" Width="200" Margin="0,10,0,0"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>


                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
