    <Compile Include="../McServerManager/Services/Interfaces/IBackupSchedulerService.cs" Link="NewCore/Services/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../McServerManager/Services/Interfaces/IBackupScheduleRestorer.cs" Link="NewCore/Services/%(RecursiveDir)%(Filename)%(Extension)" />
