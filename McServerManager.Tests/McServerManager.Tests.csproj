<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McServerManager\McServerManager.csproj" />
    <ProjectReference Include="..\McServerManager.OwnershipTestChild\McServerManager.OwnershipTestChild.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyOwnershipTestChild" AfterTargets="Build">
    <MSBuild Projects="..\McServerManager.OwnershipTestChild\McServerManager.OwnershipTestChild.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="OwnershipTestChildTarget" />
    </MSBuild>
    <PropertyGroup>
      <OwnershipTestChildDirectory>@(OwnershipTestChildTarget->'%(RootDir)%(Directory)')</OwnershipTestChildDirectory>
    </PropertyGroup>
    <ItemGroup>
      <OwnershipTestChildFiles Include="$(OwnershipTestChildDirectory)*.dll;$(OwnershipTestChildDirectory)*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(OwnershipTestChildFiles)" DestinationFolder="$(TargetDir)OwnershipTestChild" />
  </Target>

</Project>
