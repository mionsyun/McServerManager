<Window x:Class="MaiPort.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="780"
        Height="760"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="MaiPort" Style="{StaticResource ScreenTitle}"/>
            <TextBlock Text="UPnP と Windows ファイアウォールをまとめて設定するポート開放ツール"
                       Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- ポート設定 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ポートを開放する" Style="{StaticResource SectionHeading}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="ポート番号" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Forward.PortText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="プロトコル" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Forward.ProtocolOptions}"
                                          SelectedItem="{Binding Forward.SelectedProtocol}"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="用途（メモ）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Forward.Description, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox Content="ルーターに UPnP でポート転送を設定する"
                                      IsChecked="{Binding Forward.UseUpnp}"/>
                            <CheckBox Content="Windows ファイアウォールの受信を許可する"
                                      IsChecked="{Binding Forward.UseFirewall}"/>
                        </StackPanel>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="開放する"
                                    Style="{StaticResource AccentButton}"
                                    MinWidth="120"
                                    Margin="0,0,8,8"
                                    Command="{Binding Forward.OpenCommand}"/>
                            <Button Content="開放を解除する"
                                    MinWidth="120"
                                    Margin="0,0,8,8"
                                    Command="{Binding Forward.CloseCommand}"/>
                            <Button Content="使用状況を確認"
                                    MinWidth="120"
                                    Margin="0,0,8,8"
                                    Command="{Binding Forward.CheckUsageCommand}"/>
                            <Button Content="Palworld (UDP 8211)"
                                    MinWidth="150"
                                    Margin="0,0,8,8"
                                    ToolTip="ポート番号 8211 / UDP / 用途 Palworld を入力欄にセットします。"
                                    Command="{Binding Forward.ApplyPalworldPresetCommand}"/>
                        </WrapPanel>

                        <TextBlock Text="{Binding Forward.StatusMessage}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- この PC の状態 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="この PC の状態" Style="{StaticResource SectionHeading}"/>
                            <Button Grid.Column="1"
                                    Content="更新"
                                    MinWidth="80"
                                    VerticalAlignment="Top"
                                    Command="{Binding Status.RefreshCommand}"/>
                        </Grid>

                        <TextBlock Text="{Binding Status.AdministratorText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run Text="LAN IP: " Foreground="{DynamicResource BrushTextMuted}"/>
                            <Run Text="{Binding Status.LanIpText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run Text="グローバル IP: " Foreground="{DynamicResource BrushTextMuted}"/>
                            <Run Text="{Binding Status.PublicIpText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="UPnP: " Foreground="{DynamicResource BrushTextMuted}"/>
                            <Run Text="{Binding Status.UpnpText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 開放中のポート -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="開放中のポート" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="このツールで開放したポートを記録しています。不要になったら「閉じる」で解除してください。"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Forward.Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushCard}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="閉じる"
                                                    MinWidth="80"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding CloseCommand}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ログ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ログ" Style="{StaticResource SectionHeading}"/>
                    <Button Grid.Column="1"
                            Content="クリア"
                            MinWidth="80"
                            VerticalAlignment="Top"
                            Command="{Binding Log.ClearCommand}"/>
                </Grid>
                <ListBox ItemsSource="{Binding Log.Lines}" Height="160">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>
