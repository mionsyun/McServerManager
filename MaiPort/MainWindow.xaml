<Window x:Class="MaiPort.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="820"
        Height="800"
        MinWidth="720"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding Forward.OpenCommand}"/>
        <KeyBinding Key="F5" Command="{Binding Status.RefreshCommand}"/>
    </Window.InputBindings>
    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Forward.IsBusy}" Value="True">
                    <Setter Property="Cursor" Value="Wait"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushCard}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MaiPort" Style="{StaticResource AppTitle}"/>
                        <Border Background="{DynamicResource BrushAccentSoft}"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushAccent}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="ルーターと Windows ファイアウォールをまとめて設定して、ポートを開放します。"
                               Style="{StaticResource MutedText}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource BrushIdleSoft}"
                        CornerRadius="14"
                        Padding="12,6">
                    <TextBlock FontSize="12.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="通常ユーザーで実行中"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.IsAdministrator}" Value="True">
                                        <Setter Property="Text" Value="管理者として実行中"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,4">
            <StackPanel>

                <!-- 現在の状態 -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Background" Value="{DynamicResource BrushIdleSoft}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Forward.IsCurrentPortOpen}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushSuccessSoft}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Forward.CurrentPortLabel}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Forward.StatusMessage}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border HorizontalAlignment="Right" CornerRadius="16" Padding="16,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BrushBorder}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Forward.IsCurrentPortOpen}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccess}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Forward.CurrentStateText}" FontWeight="Bold" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Forward.IsCurrentPortOpen}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushTextOnAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Button Style="{StaticResource LinkButton}"
                                Content="接続先をコピー"
                                HorizontalAlignment="Right"
                                Margin="0,6,0,0"
                                ToolTip="「グローバルIP:ポート番号」をコピーします。フレンドにそのまま渡せます。"
                                Command="{Binding CopyAddressCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 設定と実行 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="開放するポート" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="よく使う設定から選ぶ" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding Forward.Presets}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButton}"
                                            Content="{Binding Name}"
                                            Command="{Binding DataContext.Forward.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="ポート番号" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PortTextBox"
                                         Text="{Binding Forward.PortText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="5"
                                         FontSize="18"
                                         TabIndex="0"
                                         ToolTip="1〜65535 の数字。Enter キーで開放を実行します。"
                                         PreviewTextInput="OnPortPreviewTextInput"
                                         PreviewKeyDown="OnPortPreviewKeyDown"
                                         DataObject.Pasting="OnPortPasting">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Forward.IsPortValid}" Value="False">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="1〜65535 で入力してください" Margin="2,6,0,0" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Forward.IsPortValid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="プロトコル" Style="{StaticResource FieldLabel}"/>
                                <ListBox Style="{StaticResource SegmentList}"
                                         ItemsSource="{Binding Forward.ProtocolOptions}"
                                         SelectedItem="{Binding Forward.SelectedProtocol}"
                                         DisplayMemberPath="Label"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="メモ（何に使うポートか）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Forward.Description, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="設定する場所" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Margin="0,0,0,4">
                            <CheckBox IsChecked="{Binding Forward.UseUpnp}" Content="ルーター（UPnP でポート転送を追加）"/>
                            <TextBlock Text="外部から接続できるようにします。ルーターの UPnP が有効である必要があります。"
                                       Style="{StaticResource MutedText}"
                                       Margin="30,2,0,12"/>
                            <CheckBox IsChecked="{Binding Forward.UseFirewall}" Content="Windows ファイアウォール（受信を許可）"/>
                            <TextBlock Text="この PC 側の受信をブロックしないようにします。設定時に UAC の確認が出ます。"
                                       Style="{StaticResource MutedText}"
                                       Margin="30,2,0,0"/>
                        </StackPanel>

                        <Border Background="{DynamicResource BrushBorder}" Height="1" Margin="0,18,0,18"/>

                        <ProgressBar Height="3"
                                     Margin="0,0,0,12"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource BrushAccent}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Visibility="{Binding Forward.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    MinWidth="200"
                                    TabIndex="1"
                                    ToolTip="Enter キーでも実行できます。"
                                    Command="{Binding Forward.OpenCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="ポートを開放する"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Forward.IsBusy}" Value="True">
                                                <Setter Property="Content" Value="処理中…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="開放を解除"
                                        MinWidth="110"
                                        Margin="0,0,8,0"
                                        Command="{Binding Forward.CloseCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="使用状況を確認"
                                        MinWidth="130"
                                        ToolTip="このポートを今使っているアプリを調べます。"
                                        Command="{Binding Forward.CheckUsageCommand}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 開放中のポート -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="開放中のポート" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="まだありません。上の「ポートを開放する」を押すと、ここに一覧が出ます。"
                                   Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Forward.Rules.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Forward.Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           Style="{StaticResource MutedText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Content="解除"
                                                    MinWidth="88"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding CloseCommand}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- この PC の状態 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="この PC とネットワーク" Style="{StaticResource SectionTitle}"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource LinkButton}"
                                    Content="再確認"
                                    VerticalAlignment="Top"
                                    ToolTip="F5 キーでも実行できます。"
                                    Command="{Binding Status.RefreshCommand}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="この PC の IP" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.LanIpText}" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="グローバル IP" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.PublicIpText}" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ルーター (UPnP)" Style="{StaticResource MutedText}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.UpnpText}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ログ -->
        <Border Grid.Row="2"
                Background="{DynamicResource BrushCard}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Expander IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ログ" FontWeight="SemiBold"/>
                        <TextBlock Text="  （うまくいかないときはここを確認）" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <Grid Margin="0,10,0,0">
                    <ListBox x:Name="LogList"
                             Style="{StaticResource LogList}"
                             ItemsSource="{Binding Log.Lines}"
                             Height="150">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Style="{StaticResource LinkButton}"
                            Content="消去"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-32,0,0"
                            Command="{Binding Log.ClearCommand}"/>
                </Grid>
            </Expander>
        </Border>
    </Grid>
</Window>
