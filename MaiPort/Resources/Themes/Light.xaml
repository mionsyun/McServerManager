<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ベース -->
    <SolidColorBrush x:Key="BrushBg" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="BrushCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#E3E8EF"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#C9D2DE"/>
    <SolidColorBrush x:Key="BrushHover" Color="#F0F3F8"/>
    <SolidColorBrush x:Key="BrushPressed" Color="#E4E9F1"/>

    <!-- テキスト -->
    <SolidColorBrush x:Key="BrushText" Color="#16202C"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#65727F"/>
    <SolidColorBrush x:Key="BrushTextOnAccent" Color="#FFFFFF"/>

    <!-- アクセント -->
    <SolidColorBrush x:Key="BrushAccent" Color="#2F6FED"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="#255FD4"/>
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#1E51B8"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#EAF1FE"/>

    <!-- 状態 -->
    <SolidColorBrush x:Key="BrushSuccess" Color="#12885E"/>
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="#E6F6EF"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#B26B00"/>
    <SolidColorBrush x:Key="BrushWarningSoft" Color="#FDF3E2"/>
    <SolidColorBrush x:Key="BrushIdleSoft" Color="#EEF1F6"/>

    <!-- ログ -->
    <SolidColorBrush x:Key="BrushLogBg" Color="#FBFCFE"/>
    <SolidColorBrush x:Key="BrushLogText" Color="#3C4856"/>
</ResourceDictionary>
